{{!
    @template mod_aiinteractivevideo/type_fillblanks

    Fill the gaps from a word bank.

    Example context (json):
    {"segments": [{"text": "The ", "blank": 0, "token": ""}, {"text": "", "blank": 1, "token": "b1"}],
     "items": [{"token": "w1", "text": "heart", "n": 1}]}
}}
<div class="aiv-cloze">
    <p class="aiv-passage">{{#segments}}{{#blank}}<button type="button" class="aiv-gap" data-drop="gap" data-token="{{token}}"><span class="aiv-gap-text"></span><span class="aiv-mark" aria-hidden="true"></span></button>{{/blank}}{{^blank}}<span>{{text}}</span>{{/blank}}{{/segments}}</p>
    <div class="aiv-tray aiv-bank" data-region="tray" data-drop="tray" role="group">
        {{#items}}
        <button type="button" class="aiv-chip" data-token="{{token}}"><span class="aiv-chip-text">{{text}}</span></button>
        {{/items}}
    </div>
</div>
