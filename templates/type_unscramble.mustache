{{!
    @template mod_aiinteractivevideo/type_unscramble

    Word builder: tap letter tiles into the slots.

    Example context (json):
    {"words": [{"slots": [{"key": "p0", "n": 1}]}], "items": [{"token": "l1", "text": "A", "n": 1}]}
}}
<div class="aiv-word-builder">
    <div class="aiv-slots" data-region="slots">
        {{#words}}
        <span class="aiv-slotword">
            {{#slots}}<button type="button" class="aiv-slot" data-key="{{key}}"><span class="aiv-slot-letter"></span></button>{{/slots}}
        </span>
        {{/words}}
    </div>
    <div class="aiv-tiles" data-region="tiles">
        {{#items}}
        <button type="button" class="aiv-tile" data-token="{{token}}">{{text}}</button>
        {{/items}}
    </div>
</div>
