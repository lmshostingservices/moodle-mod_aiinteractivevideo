{{!
    @template mod_aiinteractivevideo/type_spotmistake

    Spot the mistake: tap the wrong word(s).

    Example context (json):
    {"segments": [{"text": "The", "token": "w1", "blank": 0}]}
}}
<div class="aiv-spot">
    <span class="aiv-spot-quote" aria-hidden="true">“</span>
    <p class="aiv-spot-text">{{#segments}}<button type="button" class="aiv-word" data-token="{{token}}" aria-pressed="false"><span class="aiv-word-text">{{text}}</span><span class="aiv-word-fix" data-region="fix"></span></button> {{/segments}}</p>
</div>
