{{!
    @template mod_aiinteractivevideo/player_chapters

    Section list shown beside the video while it plays.

    Example context (json):
    {
        "sections": [
            {"index": 0, "number": 1, "title": "Why the heart confused people", "time": "0:00", "pause": "0:44",
             "typename": "Card select", "typekey": "cardselect", "status": "pending"}
        ],
        "count": 1
    }
}}
<div class="aiv-chapters">
    <div class="aiv-panel-head">
        <span class="aiv-kicker">{{#str}} interactions, mod_aiinteractivevideo {{/str}}</span>
        <span class="aiv-progress-text" data-region="progresstext"></span>
    </div>
    <div class="aiv-progressbar" aria-hidden="true"><span data-region="progressfill"></span></div>
    <ol class="aiv-chapter-list" data-region="chapterlist">
        {{#sections}}
        <li class="aiv-chapter is-{{status}}" data-index="{{index}}">
            <button type="button" class="aiv-chapter-btn" data-action="chapter" data-index="{{index}}">
                <span class="aiv-chapter-n" aria-hidden="true">
                    <span class="aiv-n">{{number}}</span>
                    <svg viewBox="0 0 24 24" class="aiv-n-solved"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                    <svg viewBox="0 0 24 24" class="aiv-n-missed"><path d="M6 12h12"/></svg>
                    <svg viewBox="0 0 24 24" class="aiv-n-locked"><rect x="5" y="11" width="14" height="10" rx="2.5"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
                </span>
                <span class="aiv-chapter-body">
                    <span class="aiv-chapter-title">{{title}}</span>
                    <span class="aiv-chapter-meta"><span class="aiv-typechip aiv-type-{{typekey}}">{{typename}}</span><span>{{time}} – {{pause}}</span></span>
                </span>
                <span class="aiv-chapter-state" aria-hidden="true"></span>
            </button>
        </li>
        {{/sections}}
    </ol>
    <div class="aiv-upnext" data-region="upnext" hidden>
        <span class="aiv-upnext-ring" aria-hidden="true"><svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15"/><circle cx="18" cy="18" r="15" class="aiv-upnext-fg" data-region="upnextring"/></svg></span>
        <span class="aiv-upnext-text"><span class="aiv-kicker">{{#str}} nextup, mod_aiinteractivevideo {{/str}}</span><strong data-region="upnexttitle"></strong></span>
    </div>
</div>
