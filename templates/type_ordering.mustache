{{!
    @template mod_aiinteractivevideo/type_ordering

    Sequence: put items in order.

    Example context (json):
    {"items": [{"token": "s1", "text": "First", "n": 1}], "moveup": "Up", "movedown": "Down"}
}}
<ol class="aiv-order" data-region="list">
    {{#items}}
    <li class="aiv-order-item" data-token="{{token}}">
        <span class="aiv-order-grip" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="6" r="1.3"/><circle cx="15" cy="6" r="1.3"/><circle cx="9" cy="12" r="1.3"/><circle cx="15" cy="12" r="1.3"/><circle cx="9" cy="18" r="1.3"/><circle cx="15" cy="18" r="1.3"/></svg></span>
        <span class="aiv-order-n" aria-hidden="true"></span>
        <span class="aiv-order-text">{{text}}</span>
        <span class="aiv-order-moves">
            <button type="button" class="aiv-mini" data-move="-1" aria-label="{{moveup}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg></button>
            <button type="button" class="aiv-mini" data-move="1" aria-label="{{movedown}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
        </span>
        <span class="aiv-mark" aria-hidden="true"></span>
    </li>
    {{/items}}
</ol>
