{{!
    @template mod_aiinteractivevideo/type_cardselect

    Card select: tap every card that fits.

    Example context (json):
    {"items": [{"token": "a1", "text": "Aorta", "n": 1}]}
}}
<div class="aiv-cards" role="group">
    {{#items}}
    <button type="button" class="aiv-selcard" data-token="{{token}}" aria-pressed="false">
        <span class="aiv-selcard-inner">
            <span class="aiv-selcard-check" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
            <span class="aiv-selcard-text">{{text}}</span>
        </span>
        <span class="aiv-mark" aria-hidden="true"></span>
    </button>
    {{/items}}
</div>
